  {
   "id": "appsuite-tab-install",
   "label": "Install",
   "source": "schema",
   "blocks": [
    {
     "type": "html",
     "title": "Install a package",
     "icon": "plus",
     "sub": "Installing registers the package switched off. An administrator turns it on, which runs its migrations. Inside FOS the default is the FOS tables, so there is one database and no copies.",
     "html": "<div class=\"form-grid\"><div class=\"field\"><label>Package</label><select><option>Procure to Pay</option><option>Hybrid Comms</option><option>Contracts</option></select></div><div class=\"field\"><label>Where it runs</label><select><option>Inside FOS (parent app)</option><option>Standalone</option></select></div></div><h4 style=\"margin:14px 0 6px;font-size:13px\">Where does each need get its data?</h4><div class=\"table-wrap\"><table><thead><tr><th>Need</th><th>Interface</th><th>Use</th></tr></thead><tbody><tr><td><b>Contacts</b></td><td><code>ContactStore</code></td><td><select style=\"padding:6px 8px;border:1.5px solid var(--border);border-radius:8px;background:var(--surface-2)\"><option>FOS: partners_partners + fos_partner_profiles</option><option>Own: contacts_own</option></select></td></tr><tr><td><b>Documents</b></td><td><code>DocumentStore</code></td><td><select style=\"padding:6px 8px;border:1.5px solid var(--border);border-radius:8px;background:var(--surface-2)\"><option>FOS: documents + media</option><option>Own: documents_own</option></select></td></tr><tr><td><b>Conversations</b></td><td><code>ConversationStore</code></td><td><select style=\"padding:6px 8px;border:1.5px solid var(--border);border-radius:8px;background:var(--surface-2)\"><option>FOS: communications engine + fos_communication_contexts</option><option>Own: conversations_own</option></select></td></tr><tr><td><b>Approvals</b></td><td><code>ApprovalStore</code></td><td><select style=\"padding:6px 8px;border:1.5px solid var(--border);border-radius:8px;background:var(--surface-2)\"><option>FOS: fos_vendor_approval_steps</option><option>Own: approvals_own</option></select></td></tr><tr><td><b>Audit</b></td><td><code>AuditLog</code></td><td><select style=\"padding:6px 8px;border:1.5px solid var(--border);border-radius:8px;background:var(--surface-2)\"><option>FOS: module_activity_logs</option><option>Own: audit_own</option></select></td></tr></tbody></table></div><div class=\"page-actions\" style=\"margin-top:12px\"><button class=\"btn btn-primary btn-sm\" onclick=\"showToast('Package installed disabled; enable it from Packages (prototype)','check-circle')\">Install (disabled by default)</button></div>"
    }
   ]
